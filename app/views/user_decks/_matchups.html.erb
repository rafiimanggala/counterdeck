<%# Locals: deck, matchups %>
<% cat_label = ->(c) { c == CounterRecommendation::BOARD_BREAKER ? "BREAK" : "HOLD" } %>
<% cat_class = ->(c) { c == CounterRecommendation::BOARD_BREAKER ? "bg-amber-500/20 text-amber-300" : "bg-sky-500/20 text-sky-300" } %>

<section class="mt-8">
  <h2 class="text-lg font-bold">Matchups</h2>
  <p class="mb-3 mt-0.5 text-sm text-slate-500">Which of your cards already answer each meta deck.</p>

  <% if deck.deck_entries.empty? %>
    <p class="rounded-xl border border-dashed border-slate-800 px-4 py-8 text-center text-sm text-slate-600">Add cards to your deck to see matchups.</p>
  <% else %>
    <div class="space-y-3">
      <% matchups.each do |m| %>
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-4">
          <div class="flex items-center justify-between gap-3">
            <%= link_to m.deck.name, deck_path(m.deck), class: "font-semibold hover:text-violet-300" %>
            <span class="shrink-0 text-xs font-medium <%= m.covered? ? 'text-emerald-400' : 'text-slate-500' %>">
              <%= m.have.size %>/<%= m.total %> outs · <%= m.coverage_pct %>%
            </span>
          </div>
          <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-800">
            <div class="h-full rounded-full <%= m.covered? ? 'bg-emerald-500' : 'bg-violet-600' %>" style="width: <%= m.coverage_pct %>%"></div>
          </div>

          <% if m.have.any? %>
            <div class="mt-3 flex flex-wrap gap-1.5">
              <% m.have.each do |item| %>
                <span class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-800 bg-emerald-950/40 px-2 py-1 text-xs text-emerald-200">
                  <span class="rounded px-1 py-0.5 text-[10px] font-bold <%= cat_class.(item.rec.category) %>"><%= cat_label.(item.rec.category) %></span>
                  <%= item.rec.display_name %> ×<%= item.quantity %>
                </span>
              <% end %>
            </div>
          <% end %>

          <% if m.missing.any? %>
            <details class="mt-2 text-xs">
              <summary class="cursor-pointer text-slate-500 hover:text-slate-300"><%= m.missing.size %> more out<%= "s" if m.missing.size != 1 %> you could add</summary>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <% m.missing.each do |rec| %>
                  <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-800 px-2 py-1 text-slate-400">
                    <span class="rounded px-1 py-0.5 text-[10px] font-bold <%= cat_class.(rec.category) %>"><%= cat_label.(rec.category) %></span>
                    <%= rec.display_name %>
                  </span>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
