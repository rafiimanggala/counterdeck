<% content_for :title, "My decks · CounterDeck" %>

<div class="mb-5 flex items-end justify-between gap-3">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">My decks</h1>
    <p class="mt-1 text-sm text-slate-400">Build your deck. See which of your cards counter the meta.</p>
  </div>
  <%= link_to "New deck", new_user_deck_path, class: "inline-flex min-h-[44px] shrink-0 items-center rounded-lg bg-violet-600 px-4 text-sm font-semibold text-white hover:bg-violet-500" %>
</div>

<% if @decks.any? %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <% @decks.each do |deck| %>
      <%= link_to deck, class: "group rounded-xl border border-slate-800 bg-slate-900 p-4 transition hover:border-violet-600" do %>
        <div class="font-semibold group-hover:text-violet-300"><%= deck.name %></div>
        <div class="mt-1 text-xs text-slate-500">
          <%= deck.card_count("main") %> main · <%= deck.card_count("extra") %> extra · <%= deck.card_count("side") %> side
        </div>
        <% preview = deck.deck_entries.filter_map { |e| e.card if e.card&.primary_image&.ygo_image_id }.uniq.first(5) %>
        <% if preview.any? %>
          <div class="mt-3 flex gap-1.5">
            <% preview.each { |c| %><%= render "shared/card_thumb", card: c, size: :sm %><% } %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-800 px-4 py-12 text-center">
    <p class="text-sm text-slate-400">No decks yet.</p>
    <%= link_to "Build your first deck", new_user_deck_path, class: "mt-3 inline-flex min-h-[44px] items-center rounded-lg bg-violet-600 px-4 text-sm font-semibold text-white hover:bg-violet-500" %>
  </div>
<% end %>
