<%# Locals: deck, url %>
<%= form_with model: deck, url: url, class: "space-y-3" do |f| %>
  <% if deck.errors.any? %>
    <p class="rounded-lg border border-rose-700 bg-rose-950 px-3 py-2 text-sm text-rose-300"><%= deck.errors.full_messages.to_sentence %></p>
  <% end %>
  <div>
    <%= f.label :name, "Deck name", class: "mb-1 block text-sm text-slate-400" %>
    <%= f.text_field :name, autofocus: true, placeholder: "e.g. My Snake-Eye build",
          class: "w-full rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-base focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500" %>
  </div>
  <%= f.submit class: "inline-flex min-h-[44px] items-center rounded-lg bg-violet-600 px-5 text-sm font-semibold text-white hover:bg-violet-500 cursor-pointer" %>
<% end %>
