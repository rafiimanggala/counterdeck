<%# Locals: deck, related, editable %>
<% if editable && related.any? %>
  <section class="mt-6">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-400">Suggested cards</h2>
    <div class="flex flex-wrap gap-2">
      <% related.each do |card| %>
        <%= button_to user_deck_deck_entries_path(deck, ygo_id: card.ygo_id),
              class: "group inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-950 py-1.5 pl-1.5 pr-3 text-left hover:border-violet-600" do %>
          <%= render "shared/card_thumb", card: card, size: :sm %>
          <span class="min-w-0">
            <span class="block max-w-[9rem] truncate text-xs font-medium text-slate-200"><%= card.name %></span>
            <span class="block text-[10px] text-violet-400 group-hover:text-violet-300">+ add</span>
          </span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
