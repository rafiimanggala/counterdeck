<% content_for :title, "#{@deck.name} · My Deck · CounterDeck" %>
<% content_for :wide, "1" if @editable %>
<%
  deck_json = @deck.deck_entries.map { |e|
    {
      ygo: e.card&.ygo_id, cardId: e.card_id, name: e.card&.name, kind: e.card&.card_kind,
      img: e.card&.primary_image&.ygo_image_id, zone: e.zone, qty: e.quantity
    }
  }.select { |h| h[:ygo] }
  attributes = %w[DARK LIGHT EARTH WATER FIRE WIND]
%>

<%= link_to "← My decks", user_decks_path, class: "-ml-2 inline-flex min-h-[44px] items-center px-2 text-sm text-slate-400 hover:text-slate-200" %>

<% if @editable %>
  <div data-controller="deck-builder"
       data-deck-builder-index-url-value="<%= cards_index_path %>"
       data-deck-builder-persist-url-value="<%= user_deck_deck_entries_path(@deck) %>"
       data-deck-builder-search-url-value="<%= cards_search_path %>"
       data-deck-builder-matchups-url-value="<%= matchups_user_deck_path(@deck) %>"
       data-deck-builder-format-value="tcg"
       data-deck-builder-deck-value="<%= deck_json.to_json %>">

    <%# ---- Header: name, menu, live counts, validity ---- %>
    <div class="mt-3">
      <div class="flex items-start justify-between gap-3">
        <h1 class="font-display min-w-0 truncate text-2xl font-bold tracking-wide sm:text-3xl"><%= @deck.name %></h1>
        <div class="flex shrink-0 items-center gap-2">
          <%# Save button: edits auto-save, but this flushes every queued write now,
              retries failures, and shows live status. JS repaints label + skin. %>
          <button type="button" data-deck-builder-target="saveBtn" data-action="deck-builder#saveDeck"
                  aria-live="polite" aria-atomic="true"
                  class="inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-lg border border-violet-600 bg-violet-600 px-3 text-sm font-semibold text-white transition hover:bg-violet-500">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4 3a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V6.41a1 1 0 0 0-.29-.7l-2.42-2.42a1 1 0 0 0-.7-.29H4Zm2 1h6v3H6V4Zm4 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg>
            <span>Save deck</span>
          </button>
          <details class="relative shrink-0">
            <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-lg border border-slate-800 text-slate-400 hover:border-violet-600" aria-label="Deck options">&#8943;</summary>
            <div class="absolute right-0 z-30 mt-1 w-40 rounded-lg border border-slate-800 bg-slate-900 p-1 shadow-xl">
              <%= link_to "Rename", edit_user_deck_path(@deck), class: "block rounded px-3 py-2 text-sm text-slate-300 hover:bg-slate-800" %>
              <%= button_to "Delete", @deck, method: :delete, form: { data: { turbo_confirm: "Delete this deck?" } }, class: "block w-full rounded px-3 py-2 text-left text-sm text-rose-300 hover:bg-rose-500/10" %>
            </div>
          </details>
        </div>
      </div>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <div class="flex flex-wrap gap-1.5" data-deck-builder-target="count" role="status" aria-live="polite" aria-label="Deck card counts"></div>
        <span data-deck-builder-target="validity" role="status" aria-live="polite" class="text-xs font-medium text-slate-500"></span>
        <div class="ml-auto inline-flex shrink-0 items-center gap-1.5">
          <span class="text-[11px] uppercase tracking-wide text-slate-600">Banlist</span>
          <div class="inline-flex rounded-lg border border-slate-800 bg-slate-900 p-0.5 text-xs" role="group" aria-label="Banlist format">
            <button type="button" data-action="deck-builder#setFormat" data-format="tcg" data-deck-builder-target="formatBtn" aria-pressed="true"
                    class="rounded-md bg-violet-600 px-2.5 py-1 font-semibold text-white">TCG</button>
            <button type="button" data-action="deck-builder#setFormat" data-format="md" data-deck-builder-target="formatBtn" aria-pressed="false"
                    class="rounded-md px-2.5 py-1 font-semibold text-slate-400 transition hover:text-slate-200">MD</button>
          </div>
        </div>
      </div>
    </div>

    <%# ---- Mobile pane switcher (only below sm; sm+ shows both panes) ---- %>
    <div class="mt-3 grid grid-cols-2 gap-1 rounded-xl border border-slate-800 bg-slate-900 p-1 sm:hidden">
      <button type="button" data-action="deck-builder#setTab" data-tab="deck" data-deck-builder-target="tabBtn" aria-pressed="true"
              class="rounded-lg bg-slate-800 px-3 py-2 text-sm font-medium text-slate-100">Your deck</button>
      <button type="button" data-action="deck-builder#setTab" data-tab="add" data-deck-builder-target="tabBtn" aria-pressed="false"
              class="rounded-lg px-3 py-2 text-sm font-medium text-slate-500">Add cards</button>
    </div>

    <%# ---- Two-pane: deck (left) / database (right). Side-by-side from sm up. ---- %>
    <div class="mt-4 sm:grid sm:grid-cols-12 sm:items-start sm:gap-4 lg:gap-5">

      <%# LEFT: the deck %>
      <section data-deck-builder-target="deckPane" aria-label="Your deck"
               class="rounded-2xl border border-slate-800 bg-slate-900/40 p-3 sm:col-span-5 sm:!block sm:sticky sm:top-20 sm:max-h-[calc(100dvh-6rem)] sm:overflow-y-auto lg:col-span-4">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">Your deck</h2>
        <% UserDeck::ZONES.each do |zone| %>
          <div class="mb-4">
            <h3 class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= zone %></h3>
            <div data-deck-builder-target="<%= zone %>" class="grid min-h-[64px] grid-cols-3 gap-1.5 rounded-xl border border-transparent p-1"></div>
          </div>
        <% end %>
        <div data-deck-builder-target="flash" role="status" aria-live="assertive" class="empty:hidden"></div>
      </section>

      <%# RIGHT: the card database %>
      <section data-deck-builder-target="poolPane" aria-label="Card database"
               class="hidden sm:col-span-7 sm:!block sm:sticky sm:top-20 sm:max-h-[calc(100dvh-6rem)] sm:overflow-y-auto lg:col-span-8">
        <div class="sticky top-0 z-20 -mx-1 bg-slate-950/95 px-1 pb-2 backdrop-blur">
          <input type="search" placeholder="Search cards by name…" autocomplete="off"
                 data-deck-builder-target="search" data-action="input->deck-builder#onInput"
                 class="w-full rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-base focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500">
          <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs">
            <% %w[monster spell trap].each do |t| %>
              <button type="button" data-filter="type" data-value="<%= t %>" data-action="deck-builder#setType" aria-pressed="false"
                      class="rounded-md border border-slate-800 px-2.5 py-1 capitalize text-slate-400 hover:border-slate-600"><%= t %></button>
            <% end %>
            <span class="mx-1 h-4 w-px bg-slate-800"></span>
            <% attributes.each do |a| %>
              <button type="button" data-filter="attr" data-value="<%= a %>" data-action="deck-builder#setAttr" aria-pressed="false"
                      class="rounded-md border border-slate-800 px-2 py-1 text-slate-400 hover:border-slate-600"><%= a.capitalize %></button>
            <% end %>
            <label class="ml-auto flex cursor-pointer items-center gap-1.5 text-slate-500">
              <input type="checkbox" checked data-deck-builder-target="remoteToggle" data-action="deck-builder#toggleRemote" class="accent-violet-600">
              Full database
            </label>
          </div>
        </div>
        <div data-deck-builder-target="related"></div>
        <div data-deck-builder-target="pool" class="grid grid-cols-[repeat(auto-fill,minmax(6rem,1fr))] gap-1.5">
          <p class="col-span-full py-8 text-center text-sm text-slate-600">Loading the card database…</p>
        </div>
      </section>
    </div>
  </div>
<% else %>
  <div class="mt-3">
    <h1 class="font-display truncate text-3xl font-bold tracking-wide"><%= @deck.name %></h1>
    <p class="mt-1 text-sm text-slate-500">
      <%= @deck.card_count("main") %> main · <%= @deck.card_count("extra") %> extra · <%= @deck.card_count("side") %> side
    </p>
  </div>
  <p class="mt-3 rounded-lg border border-slate-800 bg-slate-900 px-3 py-2 text-xs text-slate-500">You're viewing a shared deck (read-only).</p>
  <%= render "zones", deck: @deck, editable: false %>
<% end %>

<%# ---- Matchups (lazy; refreshed by the builder after edits settle) ---- %>
<%= turbo_frame_tag "matchups", src: matchups_user_deck_path(@deck, banlist: "tcg"), loading: :lazy do %>
  <p class="mt-8 rounded-xl border border-dashed border-slate-800 px-4 py-8 text-center text-sm text-slate-600">Loading matchups…</p>
<% end %>
