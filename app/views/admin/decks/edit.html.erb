<% content_for :title, "Edit #{@deck.name} · Admin" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <%= link_to "← Decks", admin_decks_path, class: "text-sm text-slate-400 hover:text-slate-200" %>
    <h1 class="mt-2 text-2xl font-bold"><%= @deck.name %></h1>
    <div class="mt-1"><%= render "shared/status_badge", status: @deck.status %></div>
  </div>
  <%= link_to "View on site →", deck_path(@deck), class: "text-sm text-violet-400 hover:text-violet-300" %>
</div>

<%= render "form", deck: @deck %>
