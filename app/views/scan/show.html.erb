<% content_for :title, "Scan a card — CounterDeck" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Scan a card</h1>
  <p class="mt-1 text-sm text-slate-400">Snap a physical card. We read the name and show what it counters (or what beats it).</p>
</div>

<%= form_with url: scan_path, method: :post, multipart: true, class: "space-y-3" do |f| %>
  <label class="flex cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed border-slate-700 bg-slate-900 px-4 py-10 text-center hover:border-violet-600">
    <span class="text-sm font-medium text-slate-300">Choose a photo or take one</span>
    <span class="mt-1 text-xs text-slate-500">JPG / PNG of the card front</span>
    <%= f.file_field :image, accept: "image/*", capture: "environment", class: "mt-3 text-xs text-slate-400" %>
  </label>
  <%= f.submit "Identify card", class: "w-full rounded-lg bg-violet-600 px-5 py-3 text-sm font-semibold text-white hover:bg-violet-500 cursor-pointer" %>
<% end %>

<% if alert.present? %>
  <p class="mt-4 rounded-lg border border-rose-700 bg-rose-950 px-4 py-2 text-sm text-rose-300"><%= alert %></p>
<% end %>

<% if @result %>
  <div class="mt-6">
    <% if @result.error %>
      <p class="rounded-lg border border-rose-700 bg-rose-950 px-4 py-3 text-sm text-rose-300"><%= @result.error %></p>
    <% elsif @result.matched? %>
      <div class="rounded-xl border border-emerald-700 bg-emerald-950/40 p-4">
        <div class="text-xs uppercase tracking-wide text-emerald-400">Identified (<%= (@result.score * 100).round %>% match)</div>
        <div class="mt-1 text-xl font-bold"><%= @result.card.name %></div>
        <div class="text-sm text-slate-400"><%= @result.card.card_kind %> · TCG <%= @result.card.banlist_status("tcg") %> · MD <%= @result.card.banlist_status("md") %></div>
      </div>

      <% if @result.counters_for.any? %>
        <section class="mt-5">
          <h2 class="mb-2 text-sm font-semibold text-slate-300">This card helps you beat:</h2>
          <div class="flex flex-wrap gap-2">
            <% @result.counters_for.each do |deck| %>
              <%= link_to deck.name, deck_path(deck), class: "rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-sm hover:border-violet-600" %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @result.key_card_of.any? %>
        <section class="mt-5">
          <h2 class="mb-2 text-sm font-semibold text-slate-300">A key card of these decks (see how to beat them):</h2>
          <div class="flex flex-wrap gap-2">
            <% @result.key_card_of.each do |deck| %>
              <%= link_to deck.name, deck_path(deck), class: "rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-sm hover:border-violet-600" %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @result.counters_for.empty? && @result.key_card_of.empty? %>
        <p class="mt-4 text-sm text-slate-500">No counter data references this card yet.</p>
      <% end %>
    <% else %>
      <p class="rounded-lg border border-amber-700 bg-amber-950/40 px-4 py-3 text-sm text-amber-300">
        Couldn't confidently match a card (best score <%= (@result.score.to_f * 100).round %>%). Try a clearer, straight-on photo of the card name.
      </p>
    <% end %>

    <% if @result.raw_text.present? %>
      <details class="mt-4 text-xs text-slate-600">
        <summary class="cursor-pointer">OCR text</summary>
        <pre class="mt-1 whitespace-pre-wrap rounded bg-slate-950 p-2"><%= @result.raw_text %></pre>
      </details>
    <% end %>
  </div>
<% end %>
