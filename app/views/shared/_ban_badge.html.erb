<%# Local: status. MD-Meta-style icon (red bar / amber 1 / yellow 2) + label. %>
<%
  label = { "forbidden" => "Forbidden", "limited" => "Limited", "semi_limited" => "Semi-Limited", "unlimited" => "Unlimited" }
  icon = ban_icon(status, size: "0.95rem")
%>
<span class="inline-flex items-center gap-1 text-xs font-medium <%= BanlistHelper::BAN_TEXT_COLOR[status] || 'text-slate-400' %>">
  <% if icon %><%= icon %><% end %>
  <%= label[status] || status %>
</span>
