<% content_for :title, "CounterDeck: break any meta deck" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight">What is your opponent playing?</h1>
  <p class="mt-1 text-sm text-slate-400">Pick their deck. Get the cards to stop, hold, and break with.</p>
</div>

<%= form_with url: root_path, method: :get, data: { turbo_frame: "deck_list", turbo_action: "advance" } do %>
  <input type="search" name="q" value="<%= @query %>" placeholder="Search deck or archetype…"
         autocomplete="off"
         class="w-full rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-base focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500"
         oninput="this.form.requestSubmit()">
<% end %>

<%= turbo_frame_tag "deck_list", class: "mt-5 block" do %>
  <% if @decks.empty? %>
    <p class="rounded-xl border border-slate-800 bg-slate-950 px-4 py-8 text-center text-sm text-slate-500">No decks match “<%= @query %>”.</p>
  <% else %>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <% @decks.each do |deck| %>
        <%= link_to deck_path(deck),
              class: "group rounded-xl border border-slate-800 bg-slate-900 p-4 transition hover:border-violet-600 hover:bg-slate-800/60" do %>
          <div class="flex items-start justify-between gap-2">
            <div>
              <div class="font-semibold group-hover:text-violet-300"><%= deck.name %></div>
              <div class="text-xs text-slate-500"><%= deck.archetype %></div>
            </div>
            <% if deck.status == "draft" %>
              <span class="rounded-full bg-amber-500/15 px-2 py-0.5 text-[10px] font-medium text-amber-300">draft</span>
            <% end %>
          </div>
          <% preview = deck.preview_cards(4) %>
          <% if preview.any? %>
            <div class="mt-3 flex gap-1.5">
              <% preview.each do |c| %>
                <%= render "shared/card_thumb", card: c, size: :sm %>
              <% end %>
            </div>
          <% end %>
          <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[11px]">
            <% deck.format_list.each do |fmt| %>
              <span class="rounded bg-slate-800 px-1.5 py-0.5 text-slate-400"><%= fmt %></span>
            <% end %>
            <span class="ml-auto text-slate-600"><%= deck.counter_recommendations.size %> counters →</span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
