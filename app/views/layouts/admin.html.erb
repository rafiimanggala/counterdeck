<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "CounterDeck Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-slate-900 text-slate-100 antialiased">
    <header class="border-b border-slate-800 bg-slate-950">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
        <%= link_to admin_root_path, class: "font-bold tracking-tight" do %>
          Counter<span class="text-violet-400">Deck</span>
          <span class="ml-2 rounded bg-violet-500/20 px-2 py-0.5 text-xs font-medium text-violet-300">admin</span>
        <% end %>
        <nav class="flex items-center gap-4 text-sm text-slate-400">
          <%= link_to "Decks", admin_decks_path, class: "hover:text-slate-100" %>
          <%= link_to "Data quality", admin_data_quality_path, class: "hover:text-slate-100" %>
          <%= link_to "View site", root_path, class: "hover:text-slate-100" %>
        </nav>
      </div>
    </header>

    <% if notice.present? %>
      <div class="mx-auto max-w-4xl px-4 pt-4">
        <p class="rounded-lg border border-emerald-700 bg-emerald-950 px-4 py-2 text-sm text-emerald-300"><%= notice %></p>
      </div>
    <% end %>

    <main class="mx-auto max-w-4xl px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>
