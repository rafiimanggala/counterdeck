<%#
  When to pull the trigger: the disruption windows, as amber lightning cards (a
  distinct colour channel from rose threats / emerald answers). Locals: enemy.
%>
<% points = enemy.interruption_points %>
<% disrupt_pool = enemy.counter_recommendations.to_a %>
<% if points.any? %>
  <section class="mt-7">
    <div class="mb-2 flex items-baseline gap-2">
      <h2 class="text-[11px] font-semibold uppercase tracking-widest text-amber-400">When to disrupt</h2>
      <span class="text-xs text-slate-600"><%= points.size %> window<%= "s" if points.size != 1 %></span>
    </div>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% points.each do |ip| %>
        <div class="rounded-xl border border-amber-900/40 bg-amber-950/15 px-3 py-2" role="note">
          <div class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 shrink-0 text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11 1 3 11h5l-1 8 8-10h-5l1-8Z"/></svg>
            <span class="font-display text-xs font-semibold uppercase tracking-wide text-amber-300"><%= ip["timing"] %></span>
          </div>
          <p class="mt-1 text-sm leading-relaxed text-slate-300"><%= ip["action"] %></p>
          <%= render "shared/play_cards", cards: cards_in_text(ip["action"], disrupt_pool, limit: 3), tone: :disrupt, builder: true %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
