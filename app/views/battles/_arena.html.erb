<%#
  The hero clash: your deck fan (violet) vs the enemy fan (rose) with a central
  readiness gauge. Handles three states: no enemy picked, enemy picked but no
  counter data, and a full matchup. Locals: to (battle_path lambda).
%>
<%
  my_faces = @my_deck.main_entries.filter_map { |e| e.card&.primary_image&.ygo_image_id }.first(4)
  enemy_faces = @enemy ? @enemy.preview_cards(4).filter_map { |c| c.primary_image&.ygo_image_id } : []
  rot = ["-rotate-6", "-rotate-2", "rotate-2", "rotate-6"]
  m = @matchup
  pct = m&.weighted_coverage_pct
  st  = pct && matchup_status(pct)
  ring = pct && readiness_ring(pct)
%>
<section class="relative overflow-hidden rounded-3xl border border-slate-800 bg-slate-950">
  <div class="grid items-center gap-4 p-5 sm:p-8 md:grid-cols-[1fr_auto_1fr]">

    <%# ---- YOUR side ---- %>
    <div class="order-1 flex flex-col items-center text-center md:items-start md:text-left">
      <span class="text-[11px] font-semibold uppercase tracking-widest text-violet-400">You</span>
      <span class="font-display text-lg font-bold tracking-wide text-slate-100 sm:text-xl"><%= @my_deck.name %></span>
      <div class="mt-3 flex justify-center pl-6 md:justify-start" aria-hidden="true">
        <% if my_faces.any? %>
          <% my_faces.each_with_index do |img, i| %>
            <%= image_tag "/card_images/#{img}.jpg", alt: "", loading: "lazy",
                  class: "-ml-6 block aspect-[59/86] w-16 rounded-lg border border-slate-900 object-cover shadow-lg ring-1 ring-violet-500/40 #{rot[i]} sm:w-20" %>
          <% end %>
        <% else %>
          <% 3.times do |i| %>
            <span class="-ml-6 block aspect-[59/86] w-16 rounded-lg border border-dashed border-violet-800/60 bg-violet-950/10 <%= rot[i] %> sm:w-20"></span>
          <% end %>
        <% end %>
      </div>
      <% if my_faces.empty? %>
        <%= link_to "Add cards to your deck", user_deck_path(@my_deck), class: "mt-3 inline-flex min-h-[40px] items-center rounded-lg border border-violet-700 px-3 text-xs font-semibold text-violet-200 hover:bg-violet-950/40" %>
      <% end %>
    </div>

    <%# ---- CENTER: gauge / prompt ---- %>
    <div class="order-2 flex flex-col items-center">
      <% if @enemy && ring %>
        <div class="relative grid h-32 w-32 place-items-center rounded-full <%= st[:pill] %>"
             role="img" aria-label="Readiness: <%= st[:label] %>, <%= pct %> percent, <%= m.have.size %> of <%= m.total %> answers you run">
          <svg class="absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="54" fill="none" stroke-width="12" class="stroke-slate-800"></circle>
            <circle cx="60" cy="60" r="54" fill="none" stroke-width="12" stroke-linecap="round"
                    class="<%= readiness_stroke(pct) %>"
                    stroke-dasharray="<%= ring[:dash] %> <%= ring[:gap] %>"></circle>
          </svg>
          <div class="text-center">
            <div class="font-display text-4xl font-bold leading-none text-slate-100"><%= pct %><span class="text-lg text-slate-500">%</span></div>
            <div class="mt-0.5 text-xs font-bold uppercase tracking-wide <%= st[:text] %>"><%= st[:label] %></div>
          </div>
        </div>
        <div class="mt-2 rounded-full border border-slate-800 bg-slate-900 px-2.5 py-1 text-[11px] text-slate-400">
          <span class="font-semibold text-slate-200"><%= m.have.size %></span> of <%= m.total %> answers you run
        </div>
        <% if m.answers_key_card? %>
          <div class="mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-300">
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1.5 3 4.2v5c0 4 2.9 7.6 7 9.3 4.1-1.7 7-5.3 7-9.3v-5L10 1.5Zm3.5 6.8-4 4.2a1 1 0 0 1-1.45 0L6 10.3a1 1 0 1 1 1.45-1.38l1.32 1.4 3.28-3.45a1 1 0 1 1 1.45 1.4Z" clip-rule="evenodd"/></svg>
            Answers their key card
          </div>
        <% else %>
          <div class="mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-amber-300">
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.49 2.6a1.73 1.73 0 0 1 3.02 0l6.3 11.25A1.73 1.73 0 0 1 16.3 16.5H3.7a1.73 1.73 0 0 1-1.51-2.65L8.49 2.6ZM10 7a1 1 0 0 0-1 1v3a1 1 0 1 0 2 0V8a1 1 0 0 0-1-1Zm0 7.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z" clip-rule="evenodd"/></svg>
            No hard answer to their key card yet
          </div>
        <% end %>
      <% elsif @enemy %>
        <div class="grid h-32 w-32 place-items-center rounded-full border border-dashed border-slate-700 text-center text-xs text-slate-500">No counter<br>data yet</div>
      <% else %>
        <div class="flex flex-col items-center gap-2 text-center">
          <span class="font-display text-2xl font-bold text-slate-600">VS</span>
          <p class="max-w-[10rem] text-xs text-slate-500">Pick an enemy deck above to scout the matchup.</p>
        </div>
      <% end %>
    </div>

    <%# ---- ENEMY side ---- %>
    <div class="order-3 flex flex-col items-center text-center md:items-end md:text-right">
      <span class="text-[11px] font-semibold uppercase tracking-widest text-rose-400">They</span>
      <% if @enemy %>
        <span class="font-display text-lg font-bold tracking-wide text-slate-100 sm:text-xl"><%= @enemy.name %></span>
        <% if (tn = @enemy.tier.to_s[/tier\s*\d+/i]&.titleize) %>
          <span class="mt-1 rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide <%= @enemy.tier_rank <= 1 ? 'bg-rose-500/15 text-rose-300' : 'bg-slate-800 text-slate-400' %>"><%= tn %></span>
        <% end %>
        <div class="mt-3 flex justify-center pl-6 md:justify-end md:pl-0 md:pr-6" aria-hidden="true">
          <% if enemy_faces.any? %>
            <% enemy_faces.each_with_index do |img, i| %>
              <%= image_tag "/card_images/#{img}.jpg", alt: "", loading: "lazy",
                    class: "-ml-6 block aspect-[59/86] w-16 rounded-lg border border-slate-900 object-cover shadow-lg ring-1 ring-rose-500/40 #{rot[i]} sm:w-20" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <span class="font-display text-lg font-bold text-slate-600">???</span>
        <div class="mt-3 flex justify-center pl-6 md:justify-end" aria-hidden="true">
          <% 3.times do |i| %>
            <span class="-ml-6 block aspect-[59/86] w-16 rounded-lg border border-dashed border-rose-900/60 bg-rose-950/10 <%= rot[i] %> sm:w-20"></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
