<%#
  Where your coverage is solid vs hollow, split by impact tier. A single % hides
  whether you own the BEST outs or just the weak ones; this shows it. Filled cell
  = an out you run, empty cell = a recommended out you are missing. Locals: m.
%>
<%
  rows = m.tier_split.reject { |r| (r[:have] + r[:missing]).zero? }
  tier_label = { high: "High", medium: "Medium", low: "Low" }
%>
<% if rows.any? %>
  <section class="mt-5 rounded-2xl border border-slate-800 bg-slate-900/40 p-4">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">Coverage by impact</h2>
      <p class="flex items-center gap-3 text-[10px] text-slate-500">
        <span class="inline-flex items-center gap-1"><span class="h-2.5 w-3.5 rounded-sm bg-slate-400"></span>You run it</span>
        <span class="inline-flex items-center gap-1"><span class="h-2.5 w-3.5 rounded-sm bg-slate-800 ring-1 ring-inset ring-slate-700"></span>Missing</span>
      </p>
    </div>
    <div class="space-y-2.5">
      <% rows.each do |r| %>
        <% total = r[:have] + r[:missing] %>
        <div class="flex items-center gap-3" title="<%= r[:have] %> of <%= total %> <%= CounterImpact.label(r[:tier]).downcase %> outs in your deck">
          <span class="w-14 shrink-0 text-[10px] font-bold uppercase tracking-wide text-slate-500"><%= tier_label[r[:tier]] %></span>
          <div class="flex flex-1 flex-wrap gap-1" role="img" aria-label="<%= tier_label[r[:tier]] %> impact: <%= r[:have] %> of <%= total %> outs owned">
            <% r[:have].times do %>
              <span class="h-2.5 w-5 rounded-sm <%= tier_cell_color(r[:tier]) %>"></span>
            <% end %>
            <% r[:missing].times do %>
              <span class="h-2.5 w-5 rounded-sm bg-slate-800 ring-1 ring-inset ring-slate-700"></span>
            <% end %>
          </div>
          <span class="w-10 shrink-0 text-right text-[11px] tabular-nums text-slate-500"><%= r[:have] %>/<%= total %></span>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
